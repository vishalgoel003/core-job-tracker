global_settings:
  output_base_dir: "./targets"
  default_relevance: 0
  max_parallel_scrapers: 4          # Max concurrent company scraping threads
  scraper_interval_hours: 12        # How often the automated background scheduler runs

# ── LLM Provider Configuration ──────────────────────────────────────────────
# Routing: Model-First Cascade
#   Each pipeline stage defines an ordered list of preferred models.
#   The client exhausts ALL api_keys for ALL capable providers for a given
#   model before falling back to the next model in the stage's list.
#   If none of the stage's curated models exist in any configured provider,
#   the client falls back to trying all available models in config order.
#
# Per-provider:
#   api_keys: list of API keys (one per free-tier account/"family account")
#             Omit or leave empty for local endpoints (Ollama/LM Studio).
#   models:   list of model identifiers this provider can serve.
#             Keep this updated as providers add new models.
#   rpm_limit: requests/minute limit PER KEY (each account has its own quota).
#              Set to 0 for local endpoints (no rate limiting applied).
#
# For Tailscale remote GPU access: use http://<tailscale-hostname>:<port>/v1/...
llm:
  inter_call_delay_s: 2.0          # Polite delay between consecutive LLM calls

  providers:
    # ── Local Models (fastest, no rate limits, no API keys needed) ──────────
    # Ollama default port: 11434  |  LM Studio default port: 1234
    # Over Tailscale: replace localhost with your Tailscale hostname/IP
    # - name: "ollama-local"
    #   base_url: "http://localhost:11434/v1/chat/completions"
    #   models:                        # Must match models pulled in Ollama
    #     - "llama3.1:8b"
    #     - "qwen2.5:14b"
    #   rpm_limit: 0                   # No rate limiting for local endpoints

    # - name: "ollama-tailscale"       # Remote GPU over Tailscale
    #   base_url: "http://my-gpu-laptop:11434/v1/chat/completions"
    #   models:
    #     - "qwen2.5:14b"
    #     - "llama3.1:8b"
    #   rpm_limit: 0

    # - name: "lmstudio-local"
    #   api_keys:
    #     - "not-needed"               # LM Studio requires a non-empty string
    #   base_url: "http://localhost:1234/v1/chat/completions"
    #   models:
    #     - "loaded-model-name"        # Match the model loaded in LM Studio UI
    #   rpm_limit: 0

    # ── Cloud Free-Tier Providers ─────────────────────────────────────────
    # Add multiple api_keys to pool free-tier accounts ("family accounts").
    # Each key has its own rpm_limit quota — exhausting one key tries the next.

    # - name: "cohere"                   # DEPRECATED — unstable JSON output
    #   api_keys:
    #     - ""                           # https://dashboard.cohere.com/api-keys
    #   base_url: "https://api.cohere.com/v2/chat"
    #   models:
    #     - "command-a-plus-05-2026"
    #     - "command-a-03-2025"
    #   rpm_limit: 20

    - name: "groq"
      api_keys:                        # https://console.groq.com/keys
        - "gsk_xxxxxxxxxxxxxxxxxxxx"   # Account 1
        # - "gsk_yyyyyyyyyyyyyyyyyy"   # Account 2 (uncomment to add)
      base_url: "https://api.groq.com/openai/v1/chat/completions"
      models:                          # Update as Groq adds new models
        - "openai/gpt-oss-120b"        # 120B dense — strongest quality (30 RPM, 1K RPD)
        - "meta-llama/llama-4-scout-17b-16e-instruct"  # Llama 4 MoE (30 RPM, 1K RPD)
        - "qwen/qwen3-32b"             # 32B thinking model (60 RPM, 1K RPD)
      rpm_limit: 30                    # Free-tier: 30 req/min per key

    - name: "gemini"
      api_keys:                        # https://aistudio.google.com/apikey
        - "AIzaSyXXXXXXXXXXXXXXXXXXXX"
        # - "AIzaSyYYYYYYYYYYYYYYYYYYYY"
      base_url: "https://generativelanguage.googleapis.com/v1beta/models"
      models:                          # Update as Google releases new models
        - "gemma-4-31b-it"             # 1.5k RPD, unlimited TPM (best free option)
        - "gemini-3.1-flash-lite"      # 500 RPD
        - "gemini-2.5-flash"           # 20 RPD
      rpm_limit: 15                    # Free-tier: 15 req/min per key

    - name: "cerebras"
      api_keys:                        # https://cloud.cerebras.ai
        - "csk-xxxxxxxxxxxxxxxxxxxx"
      base_url: "https://api.cerebras.ai/v1/chat/completions"
      models:
        - "gpt-oss-120b"
        - "zai-glm-4.7"
      rpm_limit: 5

    - name: "openrouter"
      api_keys:                        # https://openrouter.ai/keys
        - ""
      base_url: "https://openrouter.ai/api/v1/chat/completions"
      models:
        - "openai/gpt-oss-120b:free"
        - "google/gemma-4-31b-it:free"
        - "qwen/qwen3-next-80b-a3b-instruct:free"
      rpm_limit: 20

  # ── Per-Stage Model Preferences ──────────────────────────────────────────
  # Each stage defines an ordered list of models (primary → fallbacks).
  # The client tries all providers+keys capable of the first model before
  # moving to the next. If no curated model is available in any configured
  # provider, all available models are tried in config order.
  #
  # Design rationale:
  #   scorecard:   structured extraction → gpt-oss-120b (largest free model, 3 providers)
  #   evaluation:  nuanced scoring → gpt-oss-120b primary, qwen3-32b for throughput
  #   gap_analysis: huge context (Supplementary data) → gemma-4-31b-it (unlimited TPM, 1.5k RPD)
  #
  # Rate limit awareness:
  #   - gpt-oss-120b: available on Groq (30 RPM), OpenRouter (20 RPM), Cerebras (5 RPM)
  #   - Gemini flash models: only 20 RPD — use sparingly, not for batch
  #   - gemma-4-31b-it: 1,500 RPD + unlimited TPM — best Google workhorse
  #   - qwen/qwen3-32b: 60 RPM on Groq — best throughput fallback
  stages:
    scorecard:
      temperature: 0.15               # Low for consistent structured output
      max_tokens: 2500                # High to allow reasoning in thinking models
      max_sleep_seconds: 0            # Fail fast, prioritize bulk scoring speed over waiting
      models:
        - "openai/gpt-oss-120b"       # Groq — 120B dense, best structured output
        - "openai/gpt-oss-120b:free"  # OpenRouter — same model, cascade fallback
        - "gpt-oss-120b"              # Cerebras — same model, last resort (5 RPM)
        - "meta-llama/llama-4-scout-17b-16e-instruct"  # Groq — Llama 4 MoE
        - "qwen/qwen3-32b"            # Groq — 60 RPM high throughput fallback
        - "qwen/qwen3-next-80b-a3b-instruct:free"      # OpenRouter — Qwen fallback
        - "gemma-4-31b-it"               # Google — 1,500 RPD fallback
        - "google/gemma-4-31b-it:free"   # OpenRouter — Gemma fallback
    evaluation:
      temperature: 0.10               # Very low for reproducible scoring
      max_tokens: 2000                # Increased to accommodate reasoning models
      max_sleep_seconds: 0            # Fail fast, prioritize bulk scoring speed over waiting
      models:
        - "openai/gpt-oss-120b"       # Groq — best accuracy for scoring
        - "openai/gpt-oss-120b:free"  # OpenRouter fallback
        - "gpt-oss-120b"              # Cerebras — 3rd fallback for 120B
        - "qwen/qwen3-32b"            # Groq — 60 RPM high throughput
        - "qwen/qwen3-next-80b-a3b-instruct:free"      # OpenRouter — Qwen fallback
        - "meta-llama/llama-4-scout-17b-16e-instruct"  # Groq — Llama 4 MoE
        - "gemma-4-31b-it"               # Google — 1,500 RPD, unlimited TPM
        - "google/gemma-4-31b-it:free"   # OpenRouter — Gemma fallback
    gap_analysis:
      temperature: 0.10               # Low for consistency and accuracy
      max_tokens: 8000                # Increased to accommodate massive JSON responses and reasoning
      max_sleep_seconds: 60           # Wait up to 60s for top-tier model, prevent data loss
      models:
        - "gemma-4-31b-it"               # Google — 1,500 RPD, unlimited TPM
        - "google/gemma-4-31b-it:free"   # OpenRouter — additional Gemma capacity
        - "qwen/qwen3-32b"            # Groq — high throughput fallback
        - "qwen/qwen3-next-80b-a3b-instruct:free"      # OpenRouter — Qwen fallback
        - "openai/gpt-oss-120b"       # Groq — if Google is exhausted
        - "openai/gpt-oss-120b:free"  # OpenRouter — 120B fallback
        - "gpt-oss-120b"              # Cerebras — 120B fallback
        - "meta-llama/llama-4-scout-17b-16e-instruct"  # Groq — Llama fallback
    global_insights:
      temperature: 0.10               # Low for factual matching and structured output
      max_tokens: 3500                # Safe limit to prevent 413 Payload Too Large on Groq 120B
      max_sleep_seconds: 60           # Wait up to 60s for top-tier model, prevent map-reduce data loss
      models:
        - "openai/gpt-oss-120b"       # Tier 1: 120B Dense (Groq)
        - "openai/gpt-oss-120b:free"  # Tier 1: 120B (OpenRouter)
        - "gpt-oss-120b"              # Tier 1: 120B (Cerebras)
        - "gemini-2.5-flash"          # Tier 2: Massive context & reasoning. Safe to use here because RPD limits won't be exhausted.
        - "qwen/qwen3-next-80b-a3b-instruct:free"      # Tier 3: High quality 80B
        - "qwen/qwen3-32b"            # Tier 4: Reliable mid-size
        - "gemma-4-31b-it"            
        - "google/gemma-4-31b-it:free"   
        - "meta-llama/llama-4-scout-17b-16e-instruct"
    global_gap_fill:
      temperature: 0.10               # Low for consistency and accuracy
      max_tokens: 8000                # Massive JSON output needed for the 50-item gap fill
      max_sleep_seconds: 60           # Wait up to 60s for top-tier model
      models:
        - "gemma-4-31b-it"               # Tier 1: Gemma excels at cross-referencing massive text
        - "google/gemma-4-31b-it:free"   # Tier 1: Gemma fallback
        - "qwen/qwen3-32b"            
        - "qwen/qwen3-next-80b-a3b-instruct:free"      
        - "openai/gpt-oss-120b"       
        - "openai/gpt-oss-120b:free"  
        - "gpt-oss-120b"              
        - "meta-llama/llama-4-scout-17b-16e-instruct"

# ── User Profile Paths ──────────────────────────────────────────────────────
# Used by the LLM scoring pipeline to evaluate resume against job scorecards.
user_profile:
  resume_path: "user_details/resume.md"
  custom_notes_path: "user_details/custom_notes.md"
  supplementary_dir: "user_details/SupplementaryData"
  supplementary_files:                   # Relevant files from Supplementary data export
    - "Positions.csv"
    - "Projects.csv"
    - "Skills.csv"
    - "Certifications.csv"
    - "Education.csv"
    - "Publications.csv"
    - "Recommendations_Received.csv"
    - "Honors.csv"
    - "TestScores.csv"

