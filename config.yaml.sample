global_settings:
  output_base_dir: "./targets"
  default_relevance: 0
  max_parallel_scrapers: 4          # Max concurrent company scraping threads

# ── LLM Provider Configuration ──────────────────────────────────────────────
# Providers are tried in list order (cascade). On 429/5xx/timeout → next.
# The client parses Retry-After and X-RateLimit-* response headers for smart
# backoff, critical when this moves to fully automated async.
#
# You only need ONE working provider. Leave unused api_key fields empty.
# Local models (Ollama/LM Studio) need no api_key — just the base_url.
# For Tailscale remote access: use http://<tailscale-hostname>:<port>/v1/...
llm:
  inter_call_delay_s: 2.0          # Polite delay between consecutive LLM calls
  max_retries_per_provider: 1      # Retries before cascading to next provider

  providers:
    # ── Local Models (fastest, no rate limits, no API key needed) ──────────
    # Ollama default: http://localhost:11434/v1/chat/completions
    # LM Studio default: http://localhost:1234/v1/chat/completions
    # Over Tailscale: replace localhost with your Tailscale hostname/IP
    # - name: "ollama-local"
    #   api_key: ""                  # Not required for local endpoints
    #   base_url: "http://localhost:11434/v1/chat/completions"
    #   model: "llama3.1:8b"         # Must match a model pulled in Ollama
    #   rpm_limit: 0                 # 0 = no rate limit

    # - name: "ollama-tailscale"
    #   api_key: ""
    #   base_url: "http://my-gpu-laptop:11434/v1/chat/completions"
    #   model: "qwen2.5:14b"
    #   rpm_limit: 0

    # - name: "lmstudio-local"
    #   api_key: "not-needed"        # LM Studio requires a non-empty string
    #   base_url: "http://localhost:1234/v1/chat/completions"
    #   model: "loaded-model-name"
    #   rpm_limit: 0

    # ── Cloud Free-Tier Providers ─────────────────────────────────────────
    - name: "groq"
      api_key: "gsk_xxxxxxxxxxxxxxxxxxxx"       # https://console.groq.com/keys
      base_url: "https://api.groq.com/openai/v1/chat/completions"
      model: "llama-3.3-70b-versatile"
      rpm_limit: 30                              # Free-tier requests/minute
    - name: "gemini"
      api_key: "AIzaSyXXXXXXXXXXXXXXXXXXXXXX"   # https://aistudio.google.com/apikey
      base_url: "https://generativelanguage.googleapis.com/v1beta/models"
      model: "gemini-2.0-flash"
      rpm_limit: 15
    - name: "cerebras"
      api_key: "csk-xxxxxxxxxxxxxxxxxxxx"        # https://cloud.cerebras.ai
      base_url: "https://api.cerebras.ai/v1/chat/completions"
      model: "llama-3.3-70b"
      rpm_limit: 30
    # - name: "cohere"
    #   api_key: ""
    #   base_url: "https://api.cohere.com/v2/chat"
    #   model: "command-r-plus"
    #   rpm_limit: 20
    # - name: "openrouter"
    #   api_key: ""
    #   base_url: "https://openrouter.ai/api/v1/chat/completions"
    #   model: "meta-llama/llama-3.3-70b-instruct:free"
    #   rpm_limit: 20

  # ── Per-Stage Model & Parameter Overrides ───────────────────────────────
  # Each pipeline stage can optionally override the cascade's default model.
  # If a stage override specifies a provider name, ONLY that provider is used
  # for that stage (no cascade). If omitted, the default cascade applies.
  #
  # Design rationale:
  #   - Scorecard generation is structured extraction → low temp, any model
  #   - Resume evaluation needs nuance → low temp, prefer larger model
  #   - Gap analysis is search/match → low temp, can use lighter model
  stages:
    scorecard:
      temperature: 0.15             # Low for consistent structured output
      max_tokens: 1500              # Scorecards are ~800-1200 tokens
      # provider_override: "groq"   # Pin to specific provider (optional)
      # model_override: ""          # Override the provider's default model
    evaluation:
      temperature: 0.10             # Very low for reproducible scoring
      max_tokens: 800               # Score + shortcomings list
      # provider_override: ""       # Prefer larger models for accuracy
      # model_override: ""
    gap_analysis:
      temperature: 0.10             # Low for factual matching
      max_tokens: 1200              # Coverable + uncoverable lists
      # provider_override: "ollama-local"  # Good candidate for local model
      # model_override: ""

# ── User Profile Paths ──────────────────────────────────────────────────────
# Used by the LLM scoring pipeline to evaluate resume against job scorecards.
user_profile:
  resume_path: "user_details/resume.md"
  extra_path: "user_details/extra.md"
  linkedin_dir: "user_details/Basic_LinkedInDataExport"
  linkedin_files:                   # Relevant files from LinkedIn data export
    - "Positions.csv"
    - "Projects.csv"
    - "Skills.csv"
    - "Certifications.csv"
    - "Education.csv"
    - "Publications.csv"
    - "Recommendations_Received.csv"
    - "Honors.csv"
    - "TestScores.csv"

# ── Company Targets ──────────────────────────────────────────────────────────
# Each entry defines one ATS endpoint to scrape. Only ats_type: "workday" is
# currently supported. Greenhouse, Lever, etc. are on the roadmap.
#
# To add a company:
#   1. Open their Workday career site in your browser
#   2. Apply your desired location and job family filters
#   3. Open DevTools → Network → filter for "jobs" POST request
#   4. Copy the API URL and facet IDs from the POST payload
#   5. Uncomment and fill in the entry below
